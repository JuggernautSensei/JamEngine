namespace jam.jmat;

enum eTextureChannel : byte
{
	Red   = 0,
	Green = 1,
	Blue  = 2,
	Alpha = 3
}

struct Vec3
{
  x:float;
  y:float;
  z:float;
}

table Material
{
	ambient_color                    : Vec3 (required);
	diffuse_color                    : Vec3 (required);
	specular_color                   : Vec3 (required);
	shininess                        : float;
						             
	albedo_color                     : Vec3 (required);
	roughness                        : float;
	metallic                         : float;
						             
	emissive_color                   : Vec3 (required);
	emissive_intensity               : float;
						             
	b_alpha_cutout				     : bool;
	b_double_sided                   : bool;
	b_normal_texture_fliped          : bool;
	light_texture_intensity          : float;
	emissive_texture_intensity       : float;
	vertex_displacement_scale        : float;

	metallic_texture_channel         : eTextureChannel;
	roughness_texture_channel        : eTextureChannel;

	albedo_texture_path              : string;
	normal_texture_path              : string;
	metallic_texture_path            : string;
	roughness_texture_path           : string;
	ao_texture_path                  : string;
	emissive_texture_path            : string;
	light_texture_path               : string;
	vertex_displacement_texture_path : string;
}

root_type Material;