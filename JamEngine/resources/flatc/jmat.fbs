namespace jam.jmat;

enum eTextureChannel : byte
{
	Red   = 0,
	Green = 1,
	Blue  = 2,
	Alpha = 3
}

struct Vec3
{
	x							 : float;	
	y							 : float;
	z							 : float;
}

struct MaterialParams
{
	ambient						 : Vec3;
	diffuse						 : Vec3;
	specular					 : Vec3;
	shininess					 : float;
								 
	albedo						 : Vec3;
	roughness					 : float;
	metallic					 : float;
								 
	emissive					 : Vec3;
	emission_intensity			 : float;
								 
	b_alpha_cutout				 : bool;
	b_double_sided				 : bool;
}

struct MaterialTextureSettings
{
	light_map_intensity			 : float;
	vertex_displacement_scale	 : float;
	emissive_map_intensity		 : float;
	normal_map_fliped_y			 : bool;
	metallic_map_channel		 : eTextureChannel;
	roughness_map_channel		 : eTextureChannel;
}

table MaterialTextures
{
	albedo_map_path				 : string;
	ao_map_path					 : string;
	light_map_path 				 : string;
	vertex_displacement_map_path : string;
	emissive_map_path			 : string;
	normal_map_path				 : string;
	metallic_map_path			 : string;
	roughness_map_path			 : string;
}

table Material
{
	name 						 : string;
	params						 : MaterialParams;
	textures					 : MaterialTextures;
	texture_settings			 : MaterialTextureSettings;
}

root_type Material;