namespace jam.jmsh;

enum eVertexAttribute : ubyte {
    Position,
    Normal,
    Tangent,
    Bitangent,
    Color0,
    Color1,
    Color2,
    Color3,
    BlendIndices,
    BlendWeights,
    TexCoord0,
    TexCoord1,
    TexCoord2,
    TexCoord3,
}

enum eAttributeFormat : ubyte {
    Float,
    Float2,
    Float3,
    Float4,
    UNorm8x4,
    UInt8x4       
}

struct VertexLayoutElement
{
    attrib : eVertexAttribute;
    format : eAttributeFormat;
    offset : short;
}

struct VertexLayout
{
    elems     : [VertexLayoutElement: 14];
    num_elems : int;
}

struct Vec3
{
    x : float;
    y : float;
    z : float;
}

struct AABB
{
    min : Vec3;
    max : Vec3;
}

table Mesh {
    name          : string;
    vert_data     : [ubyte];
    vertex_layout : VertexLayout;
    idx_data      : [ubyte];
    aabb          : AABB;
}

root_type Mesh;
