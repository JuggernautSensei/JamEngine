namespace jam.jmsh;

enum eVertexAttribute : ubyte {
    Position,
    Normal,
    Tangent,
    Bitangent,
    Color0,
    Color1,
    Color2,
    Color3,
    BlendIndices,
    BlendWeights,
    TexCoord0,
    TexCoord1,
    TexCoord2,
    TexCoord3,
}

enum eAttributeFormat : ubyte {
    Float         ,
    Float2        ,
    Float3        ,
    Float4        ,
    UNorm8x4      ,
    UInt8x4       
}

struct VertexLayoutElement
{
    attrib : eVertexAttribute;
    format : eAttributeFormat;
    offset : short;
}

struct VertexLayout
{
    elems : [VertexLayoutElement: 14];
    count : int;
}

struct Vec3
{
    x : float;
    y : float;
    z : float;
}

struct AABB
{
    min : Vec3;
    max : Vec3;
}

table Mesh {
    vertices      : [ubyte]      (required);
    vertex_layout : VertexLayout (required);
    indices       : [ubyte]      (required);
    aabb          : AABB;
}

root_type Mesh;
