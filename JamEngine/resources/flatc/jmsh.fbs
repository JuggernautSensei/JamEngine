namespace jam.jmsh;

enum eVertexAttribute : ubyte {
    UnknownAttribute,
    Position,
    Normal,
    Tangent,
    Bitangent,
    Color0,
    Color1,
    Color2,
    Color3,
    BlendIndices,
    BlendWeights,
    TexCoord0,
    TexCoord1,
    TexCoord2,
    TexCoord3,
}

enum eAttributeFormat : ubyte {
    UnknownFormat = 0,
    Float         = 1,
    Float2        = 2,
    Float3        = 3,
    Float4        = 4,
    UNorm8x4      = 5,
    UInt8x4       = 6
}

enum eIndexFormat : ubyte {
    UnknownIndexFormat = 0,
    UInt16             = 1,
    UInt32             = 2
}

struct VertexLayoutElement
{
    attrib : eVertexAttribute;
    format : eAttributeFormat;
    offset : short;
}

struct VertexLayout
{
    elems : [VertexLayoutElement: 14];
}

struct Vec3
{
    x : float;
    y : float;
    z : float;
}

struct AABB
{
    min : Vec3;
    max : Vec3;
}

table Mesh {
    version       : uint;
    vertices      : [ubyte]      (required);
    vertex_layout : VertexLayout (required);
    indices       : [ubyte]      (required);
    aabb          : AABB;
}

root_type Mesh;
